# Ollama — local (default) or cloud
# Local: leave OLLAMA_HOST as-is, omit OLLAMA_API_KEY
# Cloud: set OLLAMA_HOST=https://ollama.com and OLLAMA_API_KEY
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION=false
OLLAMA_THINKING=false

# OpenCode fallback (OpenAI-compatible cloud endpoint)
OPENCODE_MODEL=anthropic/claude-sonnet-4-5-20250514
OPENCODE_HOST=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=

# Browser
HEADLESS=false