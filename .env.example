# Provider chain (priority order): openrouter → ollama → opencode
# Providers without API keys are skipped automatically.

# OpenRouter — primary (requires API key)
# Models: https://openrouter.ai/models
# Multiple keys (rotate on rate-limit): comma-separated
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Ollama — always in chain (local needs no key, cloud needs key)
# Local: leave OLLAMA_HOST as-is, omit OLLAMA_API_KEY
# Cloud: set OLLAMA_HOST=https://ollama.com and OLLAMA_API_KEY
# Multiple keys (rotate on rate-limit): comma-separated
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m2.5

# OpenCode — last fallback (requires API key)
# Multiple keys (rotate on rate-limit): comma-separated
OPENCODE_MODEL=minimax-m2.5
OPENCODE_HOST=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=

# Browser
HEADLESS=false

# Global flags
VISION=false     # enable screenshot tool + vision prompt
THINKING=false   # enable thinking/streaming mode (Ollama only)
TTS=true         # read task completion aloud (set to false to disable)
DEBUG=           # set to any value to enable verbose DOM/page-state logs
LOG_TYPE=        # set to "old" for plain text log mode (default: fancy)

# CloakBrowser — stealth Chromium (C++ source-level patches)
# Binary auto-downloads on first run (~200MB, cached at ~/.cloakbrowser)
CLOAKBROWSER_AUTO_UPDATE=false
# PROXY=http://user:pass@host:port
# FINGERPRINT=42069
